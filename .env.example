# Email
RESEND_API_KEY=your_resend_api_key

# Contact
CONTACT_EMAIL=juliaesteticclinic@gmail.com

# Analytics (optional) — GA4 Measurement ID, e.g. G-XXXXXXXXXX
# When set, gtag.js loads with Google Consent Mode v2 (denied until cookie consent).
NEXT_PUBLIC_GA_ID=

# Search engine verification (optional) — paste the token only, not the full meta tag
# Google Search Console → Settings → Ownership verification → HTML tag → content="..."
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → verify → Meta tag → content="..."
BING_SITE_VERIFICATION=

# Bookio
NEXT_PUBLIC_BOOKIO_WIDGET_URL=
